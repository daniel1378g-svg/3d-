{
  "name": "picanhabrasil-proposal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild-routes.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "images": "python3 -I scripts/prepare_images.py",
    "check": "node scripts/check-i18n.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs",
    "menu": "python3 -I scripts/build_menu.py",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "^4.10.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
