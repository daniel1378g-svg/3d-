{
  "name": "giardino-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "qa": "node scripts/qa.cjs",
    "assets": "python3 -I scripts/prepare_assets.py",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
