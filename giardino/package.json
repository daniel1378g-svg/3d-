{
  "name": "giardino-proposal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "node scripts/slim-assets.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs && node scripts/build-server.mjs",
    "build:launch": "VITE_PROPOSAL=0 npm run build",
    "build:server": "node scripts/build-server.mjs",
    "build:artifact": "node scripts/slim-assets.mjs && vite build --mode artifact && node scripts/build-artifact.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist-server/server.mjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-i18n.mjs && node scripts/check-menu.mjs",
    "qa": "node scripts/browser-check.cjs",
    "perf": "node scripts/perf.cjs",
    "export": "node scripts/export-content.mjs",
    "links": "node scripts/check-links.mjs",
    "fetch": "python3 -I scripts/fetch_originals.py",
    "images": "python3 -I scripts/prepare_images.py",
    "video": "python3 -I scripts/prepare_video.py",
    "fonts": "sh scripts/subset-fonts.sh",
    "pdf:render": "sh scripts/render-pdfs.sh",
    "poster": "node scripts/render-branch.cjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
