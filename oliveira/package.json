{
  "name": "restaurante-oliveira",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "python3 -I scripts/prepare_images.py",
    "depth": "node scripts/depth-maps.mjs",
    "build": "tsc --noEmit && vite build && node scripts/postbuild-routes.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "poster": "node scripts/render-poster.mjs",
    "check": "node scripts/check.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lottie-web": "^5.13.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "suncalc": "^1.9.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "potrace": "^2.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
